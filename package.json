{
  "name": "zveltio",
  "version": "3.0.0-beta.56",
  "private": true,
  "packageManager": "bun@1.3.13",
  "description": "Self-hosted Business OS \u2014 own your hardware, own your data.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "any:ratchet": "bun run scripts/any-ratchet.ts",
    "any:suppress": "bun run scripts/suppress-existing-any.ts",
    "build": "turbo run build",
    "build:binary": "cd packages/engine && bun run build:binary",
    "changeset": "changeset",
    "check": "biome check",
    "check:fix": "biome check --write",
    "check:schema": "bun run scripts/schema-codegen.ts && bun run format && bun run scripts/schema-drift-check.ts",
    "check:shared-keys": "bun run scripts/sync-shared-message-keys.ts --check",
    "coverage:gate": "bun run scripts/coverage-gate.ts",
    "coverage:unit": "cd packages/engine && bun run test:unit:coverage",
    "dev": "turbo run dev",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "prepush": "bun run check:schema && bun run check:shared-keys && bun run any:ratchet && bun run format:check && bun run typecheck",
    "studio:build": "cd packages/studio && bun run build",
    "studio:dev": "cd packages/studio && bunx vite dev --port 5173",
    "studio:embed": "cp -r packages/studio/dist packages/engine/src/studio-dist",
    "tag": "changeset tag",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version && bun run scripts/sync-engine-version.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "bun-types": "latest",
    "svelte": "^5.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "kysely": "^0.29.0",
    "vite": "^8.1.5"
  },
  "overrides": {
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/propagator-jaeger": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "brace-expansion": "2.1.4",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "linkify-it": "5.0.2",
    "nanoid": "5.1.16",
    "postcss": "8.5.25",
    "protobufjs": "7.6.5",
    "qs": "6.15.3",
    "undici": "7.29.0",
    "vite": "8.1.5"
  }
}
