{
  "valid": {
    "a list that edits and deletes its rows": {
      "spec": "zveltio.view/2",
      "type": "list",
      "collection": "invoices",
      "create": true,
      "edit": true,
      "delete": true
    },
    "inbox": {
      "spec": "zveltio.view/2",
      "id": "mail.inbox",
      "type": "split",
      "title": "mail.inbox",
      "actions": [
        { "action": "sync", "input": { "account_id": { "$selected": "account" } } },
        { "navigate": "mail.search", "params": { "account_id": { "$selected": "account" } } }
      ],
      "panes": [
        {
          "id": "account",
          "type": "list",
          "collection": "mail_accounts",
          "fields": ["email"],
          "sort": "email"
        },
        {
          "id": "messages",
          "type": "list",
          "collection": "mail_messages",
          "filter": [{ "field": "account_id", "op": "eq", "value": { "$selected": "account" } }],
          "sort": "-received_at",
          "search": true,
          "fields": ["subject", { "field": "is_starred", "display": "flag" }],
          "emphasisWhen": [{ "field": "is_read", "op": "eq", "value": false }],
          "selectable": true,
          "bulkActions": [
            {
              "action": "setFlags",
              "label": "mail.markRead",
              "input": { "message_ids": { "$selection": "id" }, "is_read": true }
            },
            {
              "action": "deleteMessages",
              "input": { "message_ids": { "$selection": "id" } },
              "confirm": "mail.confirm.delete",
              "tone": "danger"
            }
          ]
        },
        {
          "id": "reading",
          "type": "detail",
          "collection": "mail_messages",
          "record": { "$selected": "messages" },
          "fields": ["subject", "body_html"],
          "panels": [
            {
              "type": "form",
              "collection": "mail_drafts",
              "record": { "$param": "draft_id" },
              "autosave": true,
              "submit": [
                { "save": true },
                { "action": "send", "input": { "draft_id": { "$record": "id" } } }
              ]
            }
          ]
        }
      ]
    },
    "every kind": {
      "spec": "zveltio.view/2",
      "type": "tabs",
      "items": [
        { "type": "board", "collection": "tasks", "groupBy": "status", "move": "patch" },
        { "type": "timeline", "collection": "tasks", "start": "due_on", "scale": "gantt" },
        { "type": "tree", "collection": "pages", "parent": "parent_id", "label": "title" },
        {
          "type": "matrix",
          "collection": "grants",
          "row": "role",
          "column": "widget",
          "value": "enabled",
          "edit": { "action": "setGrant" }
        },
        { "type": "map", "collection": "sites", "location": "position" },
        {
          "type": "stat",
          "source": { "collection": "invoices", "aggregate": "count" },
          "format": "number"
        },
        { "type": "form", "action": "importCsv", "fields": ["file"] },
        { "type": "form", "collection": "settings", "record": "singleton" },
        {
          "type": "list",
          "collection": "posts",
          "present": "feed",
          "fallback": { "type": "list", "collection": "posts" }
        }
      ]
    },
    "operators": {
      "spec": "zveltio.view/2",
      "type": "list",
      "collection": "tasks",
      "filter": [
        { "field": "status", "op": "in", "value": ["open", "blocked"] },
        { "field": "owner", "op": "not_in", "value": { "$selection": "id" } },
        { "field": "closed_at", "op": "null" },
        { "field": "due_on", "op": "lte", "value": { "$today": true } },
        { "field": "assignee", "op": "eq", "value": { "$user": "id" } }
      ]
    },
    "busy buttons, file handoff, onOpen and a fallback field": {
      "spec": "zveltio.view/2",
      "type": "split",
      "panes": [
        {
          "type": "list",
          "id": "messages",
          "collection": "mail_messages",
          "fields": ["subject"],
          "rowActions": [
            {
              "action": "fetchAttachment",
              "input": { "attachment_id": { "$record": "id" } },
              "busyWhen": [{ "field": "fetch_status", "op": "eq", "value": "queued" }],
              "files": {
                "write": { "name": { "$record": "filename" }, "maxBytes": { "$record": "size" } }
              }
            }
          ]
        },
        {
          "type": "detail",
          "collection": "mail_messages",
          "record": { "$selected": "messages" },
          "fields": [{ "field": "body_html", "fallback": "body_text" }],
          "onOpen": {
            "action": "setFlags",
            "input": { "message_ids": [{ "$record": "id" }], "is_read": true },
            "when": [{ "field": "is_read", "op": "eq", "value": false }]
          },
          "actions": [
            {
              "action": "send",
              "input": { "draft_id": { "$record": "id" } },
              "files": { "read": { "$record": "attachments" } }
            }
          ]
        }
      ]
    }
  },
  "invalid": {
    "a file handoff with a key view/2 does not have": {
      "spec": "zveltio.view/2",
      "type": "list",
      "collection": "x",
      "rowActions": [
        { "action": "send", "files": { "read": { "$record": "a" }, "url": "https://evil.test" } }
      ]
    },
    "an onOpen without an action": {
      "spec": "zveltio.view/2",
      "type": "detail",
      "collection": "x",
      "record": { "$param": "id" },
      "onOpen": { "input": { "id": { "$record": "id" } } }
    },
    "delete that is not a boolean": {
      "spec": "zveltio.view/2",
      "type": "list",
      "collection": "invoices",
      "delete": "yes"
    },
    "view/1 habits": {
      "spec": "zveltio.view/2",
      "type": "list",
      "collection": "invoices",
      "dataSource": "/api/data/invoices",
      "fields": [{ "field": "total", "class": "text-error" }],
      "rowActions": [{ "action": "pay", "icon": "credit-card" }]
    },
    "unknown key deep in a panel": {
      "spec": "zveltio.view/2",
      "type": "split",
      "panes": [
        { "type": "list", "collection": "a" },
        {
          "type": "detail",
          "collection": "a",
          "record": { "$selected": "x" },
          "panels": [{ "type": "list", "collection": "b", "endpoint": "/ext/x" }]
        }
      ]
    },
    "constructor": {
      "spec": "zveltio.view/2",
      "type": "list",
      "collection": "a",
      "constructor": 1
    },
    "toString": { "spec": "zveltio.view/2", "type": "list", "collection": "a", "toString": "x" },
    "__proto__": {
      "spec": "zveltio.view/2",
      "type": "list",
      "collection": "a",
      "__proto__": { "x": 1 }
    },
    "spec on a nested view": {
      "spec": "zveltio.view/2",
      "type": "tabs",
      "items": [{ "spec": "zveltio.view/2", "type": "list", "collection": "a" }]
    },
    "a dotted id on a pane": {
      "spec": "zveltio.view/2",
      "type": "tabs",
      "items": [{ "id": "mail.inbox", "type": "list", "collection": "a" }]
    },
    "in without a list": {
      "spec": "zveltio.view/2",
      "type": "list",
      "collection": "a",
      "filter": [{ "field": "s", "op": "in", "value": "open" }]
    },
    "null with a value": {
      "spec": "zveltio.view/2",
      "type": "list",
      "collection": "a",
      "filter": [{ "field": "s", "op": "null", "value": true }]
    },
    "eq without a value": {
      "spec": "zveltio.view/2",
      "type": "list",
      "collection": "a",
      "filter": [{ "field": "s", "op": "eq" }]
    },
    "unknown operator": {
      "spec": "zveltio.view/2",
      "type": "list",
      "collection": "a",
      "filter": [{ "field": "s", "op": ">" }]
    },
    "a reference outside the set": {
      "spec": "zveltio.view/2",
      "type": "list",
      "collection": "a",
      "filter": [{ "field": "s", "op": "eq", "value": { "$env": "SECRET" } }]
    },
    "a form with both": {
      "spec": "zveltio.view/2",
      "type": "form",
      "collection": "a",
      "action": "b"
    },
    "a form with neither": { "spec": "zveltio.view/2", "type": "form", "fields": ["a"] },
    "a URL as a collection": {
      "spec": "zveltio.view/2",
      "type": "list",
      "collection": "/api/data/a"
    },
    "a URL as an action": {
      "spec": "zveltio.view/2",
      "type": "list",
      "collection": "a",
      "rowActions": [{ "action": "https://evil.example/pay" }]
    },
    "a split of one pane": {
      "spec": "zveltio.view/2",
      "type": "split",
      "panes": [{ "type": "list", "collection": "a" }]
    },
    "no fields": { "spec": "zveltio.view/2", "type": "list", "collection": "a", "fields": [] },
    "page size over the cap": {
      "spec": "zveltio.view/2",
      "type": "list",
      "collection": "a",
      "pageSize": 501
    },
    "an unknown kind": { "spec": "zveltio.view/2", "type": "gallery", "collection": "a" },
    "detail without a record": { "spec": "zveltio.view/2", "type": "detail", "collection": "a" }
  },
  "actionResults": {
    "valid": {
      "navigation": { "view": "mail.compose", "params": { "draft_id": "d1", "n": 2 } },
      "navigation without params": { "view": "mail.inbox" },
      "inline view": { "view": { "type": "form", "action": "confirm", "fields": ["reason"] } },
      "file": { "file": "f_123" },
      "reveal": { "reveal": "sk_live_abc" },
      "values object": { "total": 42, "currency": "RON" },
      "values scalar": 3,
      "values null": null,
      "values list": [1, "a"]
    },
    "invalid": {
      "view and an unknown key": { "view": "mail.compose", "extra": 1 },
      "view id that is not one": { "view": "Not An Id" },
      "inline view not of the vocabulary": { "view": { "type": "list", "dataSource": "/api/x" } },
      "params with a reference": {
        "view": "mail.compose",
        "params": { "id": { "$record": "id" } }
      },
      "file not a string": { "file": 7 },
      "empty file": { "file": "" },
      "reveal with values": { "reveal": "k", "total": 1 }
    }
  }
}
