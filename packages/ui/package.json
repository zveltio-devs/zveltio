{
  "name": "@zveltio/ui",
  "version": "3.0.0-beta.92",
  "description": "The one UI kit for the Console, the App and extensions (Svelte 5, daisyUI 5).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zveltio-devs/zveltio.git",
    "directory": "packages/ui"
