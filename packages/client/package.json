{
  "name": "@zveltio/client",
  "version": "3.0.0-beta.64",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev --port 5174",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "prebuild": "bun run scripts/sync-extension-clients.ts && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "predev": "bun run scripts/sync-extension-clients.ts && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "preview": "vite preview",
    "sync:ext": "bun run scripts/sync-extension-clients.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lucide/svelte": "^0.577.0",
    "@zveltio/sdk": "workspace:*",
    "better-auth": "^1.7.2",
    "dompurify": "3.4.14",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "daisyui": "^5.7.20",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.3.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
