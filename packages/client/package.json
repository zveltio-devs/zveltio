{
  "name": "@zveltio/client",
  "version": "3.0.0-beta.60",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev --port 5174",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "prebuild": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "predev": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lucide/svelte": "^0.577.0",
    "@zveltio/sdk": "workspace:*",
    "better-auth": "^1.6.13",
    "dompurify": "3.4.12",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.18.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "daisyui": "^5.0.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.49.2",
    "svelte-check": "^4.3.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
