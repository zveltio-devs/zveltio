{
  "name": "@zveltio/engine",
  "version": "3.0.0-beta.64",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:migrations": "bun scripts/gen-embedded-migrations.ts",
    "gen:worker-source": "bun scripts/gen-worker-source.ts",
    "gen:studio-embed": "bun scripts/generate-studio-embed.ts",
    "build": "bun scripts/gen-embedded-migrations.ts && BUN_MEMORY_LIMIT=4096 bun build src/index.ts --outdir dist --target bun --packages external",
    "build:binary": "bun scripts/build-binary.ts",
    "build:prod": "bun scripts/gen-embedded-migrations.ts && BUN_MEMORY_LIMIT=2048 bun build src/index.ts --outdir dist --target bun --packages external --minify",
    "dev": "BUN_MEMORY_LIMIT=2048 bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:init": "bun src/db/migrate.ts",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "test": "bun test src/tests/unit && bun test src/tests/harness --timeout 30000",
    "test:mutation": "stryker run stryker.security.json",
    "test:watch": "bun test --watch",
    "test:unit": "bun test src/tests/unit",
    "test:unit:coverage": "bun test src/tests/unit --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "test:integration": "bun test src/tests/integration",
    "test:harness": "bun test src/tests/harness --timeout 30000",
    "test:harness:coverage": "bun test src/tests/harness --timeout 30000 --coverage --coverage-reporter=lcov --coverage-dir=coverage-harness"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "1.7.1",
    "@better-auth/passkey": "^1.7.1",
    "@hono/zod-validator": "^0.9.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@types/pg": "^8.23.1",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.1",
    "casbin": "^5.51.1",
    "expr-eval-fork": "^3.0.3",
    "hono": "^4.13.3",
    "imagescript": "^1.3.1",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.5",
    "nodemailer": "^9.0.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.18.2",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@types/nodemailer": "^8.0.1",
    "@zveltio/sdk": "workspace:*",
    "bun-types": "latest",
    "fast-check": "^4.9.0",
    "typescript": "^5.4.0"
  }
}
