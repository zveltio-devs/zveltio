{
  "name": "hello-ext-worker",
  "displayName": "Hello Worker Smoke Fixture",
  "category": "fixture",
  "description": "Same as hello-ext but with engine.isolation='worker' to exercise the Bun.Worker isolation path on the binary install; a declared route, as a signed worker extension is declared model only.",
  "version": "1.0.0",
