  "permissions": [],
  "contributes": {
    "engine": true,
    "studio": false
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false,
    "isolation": "worker"
  },
  "integrity": {
    "engineSha256": "ef35de3db04b6d89f70cf5edb91e261c09bbcb847a4e59b83ef755bcf0e208f7"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/health",
      "access": "caller",
      "handler": "health"
    }
  ]
}
