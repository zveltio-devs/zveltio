{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.json",
      "**/*.svelte",
      "!**/dist",
      "!**/build",
      "!**/node_modules",
      "!**/.svelte-kit",
      "!**/.zveltio",
      "!**/coverage",
      "!**/*.min.js",
      "!packages/engine/src/studio-dist",
      "!packages/engine/src/db/migrations/embedded.ts",
      "!packages/engine/src/db/migrations/sql",
      "!packages/engine/src/tests/fixtures/**/engine/index.js",
      "!packages/engine/src/tests/fixtures/**/engine/index.js.map",
      "!packages/engine/src/lib/worker-extension-runtime-source.generated.ts",
      "!packages/studio/src/lib/ext",
      "!packages/client/src/lib/ext",
      "!packages/studio/src/routes/(admin)/ai",
      "!packages/studio/src/routes/(admin)/analytics/dashboard",
      "!packages/studio/src/routes/(admin)/analytics/quality",
      "!packages/studio/src/routes/(admin)/billing",
      "!packages/studio/src/routes/(admin)/byod",
      "!packages/studio/src/routes/(admin)/checklists",
      "!packages/studio/src/routes/(admin)/compliance/ro/efactura",
      "!packages/studio/src/routes/(admin)/compliance/ro/procurement",
      "!packages/studio/src/routes/(admin)/content/documents",
      "!packages/studio/src/routes/(admin)/crm",
      "!packages/studio/src/routes/(admin)/developer/api-docs",
      "!packages/studio/src/routes/(admin)/developer/database",
      "!packages/studio/src/routes/(admin)/developer/edge-functions",
      "!packages/studio/src/routes/(admin)/developer/graphql",
      "!packages/studio/src/routes/(admin)/developer/validation",
      "!packages/studio/src/routes/(admin)/developer/views",
      "!packages/studio/src/routes/(admin)/finance/banking",
      "!packages/studio/src/routes/(admin)/forms",
      "!packages/studio/src/routes/(admin)/geospatial/postgis",
      "!packages/studio/src/routes/(admin)/hr/time-tracking",
      "!packages/studio/src/routes/(admin)/i18n",
      "!packages/studio/src/routes/(admin)/introspect",
      "!packages/studio/src/routes/(admin)/mail",
      "!packages/studio/src/routes/(admin)/media",
      "!packages/studio/src/routes/(admin)/pages",
      "!packages/studio/src/routes/(admin)/pos",
      "!packages/studio/src/routes/(admin)/projects/helpdesk",
      "!packages/studio/src/routes/(admin)/projects/management",
      "!packages/studio/src/routes/(admin)/search",
      "!packages/studio/src/routes/(admin)/sms",
      "!packages/studio/src/routes/(admin)/storage/cloud",
      "!packages/studio/src/routes/(admin)/traceability",
      "!packages/studio/src/routes/(admin)/workflow/approvals"
    ]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedImports": "off",
        "noUnusedFunctionParameters": "off",
        "noEmptyPattern": "off",
        "useParseIntRadix": "off",
        "useYield": "off",
        "useExhaustiveDependencies": "off"
      },
      "style": {
        "useImportType": "off",
        "useNodejsImportProtocol": "off",
        "useTemplate": "off",
        "useSelfClosingElements": "off",
        "noNonNullAssertion": "off",
        "useExponentiationOperator": "off",
        "useLiteralEnumMembers": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "off",
        "noExportsInTest": "off",
        "noImplicitAnyLet": "off",
        "noTsIgnore": "off",
        "noShadowRestrictedNames": "off",
        "noAssignInExpressions": "warn",
        "noGlobalIsNan": "warn",
        "noPrototypeBuiltins": "warn",
        "noUselessEscapeInString": "warn",
        "useBiomeIgnoreFolder": "off",
        "useIterableCallbackReturn": "off"
      },
      "complexity": {
        "noForEach": "off",
        "noBannedTypes": "off",
        "noThisInStatic": "off",
        "noStaticOnlyClass": "off",
        "noUselessContinue": "off",
        "noUselessThisAlias": "off",
        "useOptionalChain": "off",
        "useLiteralKeys": "off"
      },
      "performance": {
        "noDelete": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  },
  "overrides": [
    {
      "includes": ["**/scripts/archive/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["**/tests/**/*.ts", "**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
